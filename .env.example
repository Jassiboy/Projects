APP_NAME=Data Analyst AI
DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=analyst_ai_readonly
DB_NAME=analyst_ai
# DB_USER must have SELECT-only privileges on DB_NAME.
# Add the read-only account's DB_PASSWORD to your local .env file.

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Set GEMINI_API_KEY in the environment or local .env file.
